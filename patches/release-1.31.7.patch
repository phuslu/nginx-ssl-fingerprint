--- a/src/event/ngx_event_openssl.c
+++ b/src/event/ngx_event_openssl.c
@@ -14,6 +14,7 @@
 #endif
 
 
+#define NGX_SSL_JA_DATA_SIZE  1024
 #define NGX_SSL_PASSWORD_BUFFER_SIZE  4096
 
 
@@ -2011,6 +2012,44 @@ ngx_ssl_set_client_hello_callback(ngx_ssl_t *ssl, ngx_ssl_client_hello_arg *cb)
 
 #ifdef SSL_CLIENT_HELLO_SUCCESS
 
+static void
+ngx_ssl_client_hello_ja_cb(SSL *ssl)
+{
+    size_t             len;
+    u_char             buf[NGX_SSL_JA_DATA_SIZE];
+    ngx_str_t         *ja;
+    ngx_connection_t  *c;
+
+    c = ngx_ssl_get_connection(ssl);
+
+    if (c == NULL || c->ssl == NULL) {
+        return;
+    }
+
+    ja = &c->ssl->fp_ja_data;
+
+    if (ja->data != NULL) {
+        return;
+    }
+
+    len = SSL_client_hello_get_ja_data(ssl, buf, NGX_SSL_JA_DATA_SIZE);
+    if (len == 0) {
+        ngx_log_error(NGX_LOG_WARN, c->log, 0, "SSL_client_hello_get_ja_data "
+                "seems the buffer size is less that number of fileds; "
+                "for this SSL connection can't get a ja3 hash string");
+        return;
+    }
+
+    ja->data = ngx_pnalloc(c->pool, len);
+    if (ja->data == NULL) {
+        return;
+    }
+
+    ngx_memcpy(ja->data, buf, len);
+    ja->len = len;
+}
+
+
 int
 ngx_ssl_client_hello_callback(ngx_ssl_conn_t *ssl_conn, int *ad, void *arg)
 {
